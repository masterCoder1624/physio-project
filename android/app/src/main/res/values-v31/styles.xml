<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Keep it intentionally minimal; the full
         RehabZ experience is rendered by Flutter immediately afterwards. -->
    <style name="LaunchTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/rehabz_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/rehabz_splash_background</item>
        <item name="android:navigationBarColor">@color/rehabz_splash_background</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
